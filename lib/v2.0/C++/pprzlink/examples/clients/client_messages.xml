<?xml version="1.0"?>
<protocol>
  <msg_class name="telemetry" id="1">
    <message name="PONG" id="5"/>
    <message name="CLIENT_ALTITUDE" id="42">
      <field name="altitude" type="float" unit="m"/>
    </message>
  </msg_class>
  <msg_class name="datalink" id="2">
    <message name="PING" id="8"/>
    <message name="CLIENT_SETTING" id="43">
      <field name="ac_id" type="uint8"/>
      <field name="value" type="float"/>
    </message>
  </msg_class>
</protocol>
